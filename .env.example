# Local SQLite (fallback when TURSO_DATABASE_URL is empty)
DATABASE_URL="file:./dev.db"

# Turso / libSQL (required for Vercel serverless deployment)
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

JWT_SECRET="change-me-to-a-long-random-secret"
CRON_SECRET="change-me-cron-secret"

# Email Configuration - Nodemailer (Gmail SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-char-google-app-password"
SMTP_FROM_NAME="mw-catering-service"
SMTP_FROM_EMAIL="your-email@gmail.com"

NEXT_PUBLIC_APP_URL="http://localhost:3001"
INITIAL_ADMIN_EMAIL="admin@office.com"
INITIAL_ADMIN_PASSWORD="change-me-on-first-login"
INITIAL_ADMIN_NAME="System Admin"
